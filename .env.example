# Database Configuration
DATABASE_URL=postgres://admin:PiboSecure2025@postgres:5432/pibo_erp
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=PiboSecure2025
DB_NAME=pibo_erp

# Authentication
JWT_SECRET=PiboJWT2025SecretKeyChangeThis

# RabbitMQ
RABBITMQ_URL=amqp://rabbitmq:5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password

# Service URLs (Internal Docker Network)
AUTH_SERVICE_URL=http://pibo-auth-service:3001
VENDAS_SERVICE_URL=http://pibo-vendas-service:3002
ESTOQUE_SERVICE_URL=http://pibo-estoque-service:3003
FISCAL_SERVICE_URL=http://pibo-fiscal-service:3004
CRM_SERVICE_URL=http://pibo-crm-service:3005
FINANCEIRO_SERVICE_URL=http://pibo-financeiro-service:3006
WORKFLOW_SERVICE_URL=http://pibo-workflow-service:3007
CONTRATOS_SERVICE_URL=http://pibo-contratos-service:3008
COMPRAS_SERVICE_URL=http://pibo-compras-service:3009
CONFIG_SERVICE_URL=http://pibo-config-service:3010

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_URL=http://localhost:3001

# Environment
NODE_ENV=development

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Security (CHANGE IN PRODUCTION!)
# Generate strong secrets:
# - JWT_SECRET: openssl rand -base64 32
# - DB_PASSWORD: openssl rand -base64 24
